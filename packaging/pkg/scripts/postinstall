#!/bin/bash
# Runs after ZTab.app is installed, in one of two places (Installer's "Install for all users" or
# "Install for me only"; $2 is the target: "/" or the user's home folder):
#  - for all users: /Applications/ZTab.app. Runs as root and acts for the user logged in at the
#    screen (the console user), as that user (launchctl asuser + sudo -u, with their HOME):
#     1. an old copy in ~/Applications (bundle id dev.ztab.app) and its receipt in the home folder
#        are removed, so there is exactly one ZTab;
#     2. their login item is turned on (`ztab --set-login on` writes
#        ~/Library/LaunchAgents/dev.ztab.app.plist for the installed binary and loads it, which
#        starts ZTab now), unless this is an upgrade on which they had turned it off (preinstall's
#        note);
#     3. if ZTab is not running a few seconds later (launchd refused the job, or the login item
#        stays off), it is started directly.
#    Other users open ZTab once: its first launch for them turns their login item on (or they tick
#    "Start ZTab at login" in ZTab's Settings, if they used ZTab before); an old per-user copy of theirs
#    is theirs to remove (it is reported here, see the README). With nobody at the screen (an
#    install over ssh) only the app is installed.
#  - for me only: ~/Applications/ZTab.app, no administrator password; runs as that user. Steps 2
#    and 3 as above, for the per-user copy. A shared /Applications/ZTab.app is left alone (only an
#    administrator can remove it); this user's login item starts the per-user copy.
# Lines printed here go to /var/log/install.log.
TARGET="${2:-/}"
if [ "$TARGET" = "/" ]; then
  MODE=system
  APP="/Applications/ZTab.app"
else
  MODE=user
  APP="${TARGET%/}/Applications/ZTab.app"
fi
BIN="$APP/Contents/MacOS/ztab"
[ -x "$BIN" ] || { echo "ZTab postinstall: $BIN not found" >&2; exit 0; }
if [ "$(id -u)" = 0 ]; then
  USER_NAME=$(stat -f %Su /dev/console 2>/dev/null)
else
  USER_NAME=$(id -un)
fi
case "$USER_NAME" in
  "" | root | loginwindow | _mbsetupuser)
    echo "ZTab postinstall: nobody is logged in at the screen (console user '${USER_NAME}'): installed $APP only." \
      "Each user opens ZTab from Applications once; its first launch for them turns on start at login."
    exit 0 ;;
esac
UID_=$(id -u "$USER_NAME") || exit 0
# Their home folder (see preinstall).
USER_HOME=$(dscl -plist . -read "/Users/$USER_NAME" NFSHomeDirectory 2>/dev/null \
  | plutil -extract 'dsAttrTypeStandard:NFSHomeDirectory.0' raw -o - - 2>/dev/null)
[ -n "$USER_HOME" ] || USER_HOME=$(dscacheutil -q user -a name "$USER_NAME" 2>/dev/null | sed -n 's/^dir: //p' | head -1)
if [ -z "$USER_HOME" ] || [ ! -d "$USER_HOME" ]; then
  echo "ZTab postinstall: no home folder found for $USER_NAME: installed $APP only" >&2
  exit 0
fi
if [ "$(id -u)" = 0 ]; then
  # In the user's GUI session, as the user, with the user's HOME (ZTab finds the login agent and
  # its settings through HOME).
  as_user() { launchctl asuser "$UID_" sudo -u "$USER_NAME" /usr/bin/env HOME="$USER_HOME" "$@"; }
else
  as_user() { "$@"; }
fi

# preinstall's note (in the user's own temporary folder, read and removed as the user).
KEEP_OFF=0
TMP_=$(as_user /usr/bin/getconf DARWIN_USER_TEMP_DIR 2>/dev/null)
if [ -n "$TMP_" ]; then
  MARK="${TMP_%/}/dev.ztab.pkg.keep-login-off"
  if as_user /bin/test -f "$MARK"; then
    KEEP_OFF=1
    as_user /bin/rm -f "$MARK"
  fi
fi

# 1. For all users: this user's own per-user copy (a "me only" install, or one from 0.1.0; never the copy just installed, should
#    ~/Applications lead to /Applications). For me only: a shared copy is only reported.
OLD="$USER_HOME/Applications/ZTab.app"
if [ "$MODE" = user ]; then
  if [ -d /Applications/ZTab.app ] && ! [ /Applications/ZTab.app -ef "$APP" ]; then
    echo "ZTab postinstall: ZTab is also installed for all users in /Applications; $USER_NAME's login item starts $APP"
  fi
elif [ -d "$OLD" ] && ! [ "$OLD" -ef "$APP" ] \
  && [ "$(/usr/libexec/PlistBuddy -c 'Print CFBundleIdentifier' "$OLD/Contents/Info.plist" 2>/dev/null)" = dev.ztab.app ]; then
  pkill -u "$UID_" -f "^$OLD/Contents/MacOS/ztab" 2>/dev/null
  as_user /bin/rm -rf "$OLD" && echo "ZTab postinstall: removed the old copy $OLD"
fi
if [ "$MODE" = system ] && as_user /usr/sbin/pkgutil --volume "$USER_HOME" --pkgs 2>/dev/null | grep -qx dev.ztab.app.pkg; then
  as_user /usr/sbin/pkgutil --volume "$USER_HOME" --forget dev.ztab.app.pkg >/dev/null \
    && echo "ZTab postinstall: forgot the old package receipt in $USER_HOME"
fi
# Other users' own per-user copies stay theirs (their login item keeps starting that copy).
[ "$MODE" = system ] && for h in /Users/*; do
  [ "$h" = "$USER_HOME" ] && continue
  o="$h/Applications/ZTab.app"
  if [ -d "$o" ] && ! [ "$o" -ef "$APP" ]; then
    echo "ZTab postinstall: $(basename "$h") has their own per-user copy, $o, which their login item starts;" \
      "to use the shared copy they delete it and turn on Start at login in ZTab's Settings (see the README)"
  fi
done

# 2. The login item.
running() { pgrep -u "$UID_" -f "^$BIN" >/dev/null; }
if [ "$KEEP_OFF" = 1 ]; then
  echo "ZTab postinstall: start at login was off for $USER_NAME; leaving it off"
  # Recorded in their settings (login_item_offered), so ZTab's first launch leaves it off too.
  as_user /usr/bin/env -u ZTAB_SETTINGS_DIR "$BIN" --set-login off >/dev/null 2>&1 || true
elif ! as_user /usr/bin/env -u ZTAB_SETTINGS_DIR "$BIN" --set-login on; then
  echo "ZTab postinstall: the login item was not loaded" >&2
fi

# 3. Running?
for _ in $(seq 1 30); do running && break; sleep 0.1; done
if ! running; then
  as_user /usr/bin/open -g "$APP" --args --background || true
  for _ in $(seq 1 30); do running && break; sleep 0.1; done
  running || echo "ZTab postinstall: ZTab did not start (another copy may still be running)" >&2
fi
exit 0
